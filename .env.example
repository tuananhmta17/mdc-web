# Copy to .env.local for local work. Configure production values in the EXISTING Vercel project.
# Never commit real keys, account passwords, or local runtime data.
APP_URL=https://mdc-web-delta.vercel.app
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy server-only key is also supported instead of SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=

# Required only when the cloud database has no state yet. No demo users are created.
MDC_ADMIN_EMAIL=
MDC_ADMIN_NAME=
MDC_ADMIN_PASSWORD=

# Random secret of at least 32 characters, used by Vercel cron.
CRON_SECRET=

# Configure one real email provider:
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Or Resend, with a verified sender domain:
RESEND_API_KEY=
EMAIL_FROM=

# Optional persistent local storage for a single Node process. Never use this on Vercel.
# MDC_DATA_DIR=
